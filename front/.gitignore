# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# uploads gerados em runtime (API /api/upload/* → disco local, não versionar)
/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Volume local de uploads (docker-compose.prod: ./pazini-uploads:/app/uploads)
/pazini-uploads/
# Pasta de uploads em dev (em produção systemd monta /root/docker/pazini-uploads em /app/uploads)
/uploads/

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
