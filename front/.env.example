# ── SurrealDB (obrigatório: senha sem padrão no código da app) ──────────────
# O docker-compose na raiz do repo inicia o Surreal com usuário admin e senha
# definida no próprio compose; use a MESMA senha aqui em desenvolvimento local.
SURREALDB_HOST=127.0.0.1
SURREALDB_PORT=8000
SURREALDB_USER=admin
SURREALDB_PASS=
SURREALDB_NS=pazini
SURREALDB_DB=core

# Deploy (opcional): ajuste para seu servidor; não commite .env com valores reais.
# CONFIG_FILE=/caminho/para/sua/chave/ssh
# REMOTE_USER=deploy
# REMOTE_HOST=seu-servidor.exemplo.com
# REMOTE_PATH=/opt/docker

# JWT: mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 32)
JWT_SECRET=

# Opcional: URL pública da logo no painel Início (se vazio, usa Configurações → URL da logo ou /logo.jpeg)
# NEXT_PUBLIC_BRAND_LOGO_URL=https://exemplo.com/sua-logo.png

# Só para o script seed:portal-user (1º usuário). O login web usa a tabela portal_user.
PAZINI_LOGIN_EMAIL=admin@exemplo.com
PAZINI_LOGIN_PASSWORD=

# Política de senha (cadastro / troca na UI): força + Have I Been Pwned (k-anonymity).
# PAZINI_SKIP_PWNED_PASSWORD_CHECK=true
# PAZINI_ALLOW_PASSWORD_IF_PWNED_CHECK_FAILS=true

# Rate limit (antiautomação): memória por processo. Desligar só em dev local se necessário:
# PAZINI_RATE_LIMIT_DISABLED=true
# PAZINI_RATE_LIMIT_LOGIN_MAX=20
# PAZINI_RATE_LIMIT_LOGIN_WINDOW_MS=900000
# PAZINI_RATE_LIMIT_API_MAX=240
# PAZINI_RATE_LIMIT_API_WINDOW_MS=60000
# PAZINI_RATE_LIMIT_UPLOAD_MAX=40
# PAZINI_RATE_LIMIT_UPLOAD_WINDOW_MS=60000
# PAZINI_RATE_LIMIT_SSE_MAX=25
# PAZINI_RATE_LIMIT_SSE_WINDOW_MS=60000
